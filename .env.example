# Calendar feeds for tools/sync_week.py. Copy to .env and fill in.
#
# A feed URL is a credential: it carries its own access token and exposes your
# whole schedule to anyone holding it. .env is gitignored — keep it that way,
# and never paste a feed URL into the artifact or a commit.

# HVL, via TimeEdit — open your schedule, then "Subscribe" / "Abonner".
# Copy the webcal:// or https:// .ics link (webcal:// works, it is http).
LEDGER_FEED_HVL=

# UiB, via Canvas — Calendar, then "Calendar Feed" in the right-hand sidebar.
LEDGER_FEED_UIB=

# Work, via When I Work — Account / profile settings, calendar subscription.
# Not every account has it; if yours does not, shifts come in by hand.
LEDGER_FEED_WORK=
